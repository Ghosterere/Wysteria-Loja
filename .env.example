# Obrigatório: gere o token no Discord Developer Portal.
DISCORD_TOKEN=

# Servidor no qual os comandos devem aparecer imediatamente.
GUILD_ID=

# Banco SQLite local. Não publique este arquivo.
DATABASE_PATH=lojas.db

# Cargo entregue aos vendedores aprovados.
LOJISTA_ROLE_NAME=Lojista

# Usuários que podem comprar na própria loja para testes, separados por vírgula.
ADMIN_TESTER_IDS=

# Categorias privadas de tickets ativos e arquivados.
TICKET_CATEGORY_ID=
TICKET_ARCHIVE_CATEGORY_ID=

# Canais de texto do servidor.
SERVICE_DESK_CHANNEL_ID=
TICKET_LOG_CHANNEL_ID=
FEEDBACK_CHANNEL_ID=
BOOST_THANK_CHANNEL_ID=
SELLER_APPLICATION_CHANNEL_ID=
